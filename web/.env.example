# Server-side settings (Vercel: Project → Settings → Environment Variables;
# locally: copy to .env.local). Never prefix these with NEXT_PUBLIC_ — they
# must stay on the server.

# Site-provided ElevenLabs voices. Leave empty to use browser voices only.
ELEVENLABS_API_KEY=
# Optional
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_VOICE_ID_ES=
# Comma-separated voice IDs visitors may use (recommended for a public site)
ELEVENLABS_VOICE_IDS=

# Visitors bring their own Anthropic (Claude) key in the app's Settings page;
# there is no server-side Anthropic key.
